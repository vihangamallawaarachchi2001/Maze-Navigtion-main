<?xml version="1.0"?>
<!--
  TurtleBot3 Burger for Gazebo Harmonic (gz-sim 8).
  Dimensions follow the ROBOTIS turtlebot3_description burger URDF
  (wheel radius 0.033 m, separation 0.160 m, base_scan at (-0.032, 0, 0.172) from base_link,
  base_link 0.010 m above base_footprint). Visual geometry simplified to primitives.
  The SAME numbers are used in urdf/turtlebot3_burger.urdf (robot_state_publisher).
  TF authority: OdometryPublisher -> odom->base_footprint ; robot_state_publisher -> all fixed/wheel links.
-->
<sdf version="1.9">
  <model name="turtlebot3_burger">
    <link name="base_footprint"/>

    <link name="base_link">
      <pose>0 0 0.010 0 0 0</pose>
      <inertial>
        <pose>-0.032 0 0.070 0 0 0</pose>
        <mass>0.825</mass>
        <inertia><ixx>0.00221</ixx><iyy>0.00211</iyy><izz>0.00200</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- collision box bottom raised to 0.020 m above ground (visual keeps full size) so the
           chassis can never drag on the floor; it still covers all heights where maze walls exist -->
      <collision name="base_collision">
        <pose>-0.032 0 0.07575 0 0 0</pose>
        <geometry><box><size>0.140 0.140 0.1315</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <pose>-0.032 0 0.070 0 0 0</pose>
        <geometry><box><size>0.140 0.140 0.143</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>
      <sensor name="bumper" type="contact">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>bumper</topic>
        <contact><collision>base_collision</collision></contact>
      </sensor>
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
      </sensor>
    </link>

    <link name="base_scan">
      <pose>-0.032 0 0.182 0 0 0</pose>
      <inertial><mass>0.114</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="lidar_visual">
        <geometry><cylinder><radius>0.035</radius><length>0.030</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="hls_lfcd_lds" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>5</update_rate>
        <topic>scan</topic>
        <gz_frame_id>base_scan</gz_frame_id>
        <lidar>
          <scan><horizontal><samples>360</samples><resolution>1</resolution>
            <min_angle>0.0</min_angle><max_angle>6.28</max_angle></horizontal></scan>
          <range><min>0.120</min><max>3.5</max><resolution>0.015</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
    </link>

    <link name="wheel_left_link">
      <pose>0 0.080 0.033 -1.5707963 0 0</pose>
      <inertial><mass>0.0285</mass>
        <inertia><ixx>1.1e-05</ixx><iyy>1.1e-05</iyy><izz>2.0e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- sphere collision: DART cylinder-plane contact made the wheels slip in spins (docs/progress.md) -->
      <collision name="wheel_left_collision">
        <geometry><sphere><radius>0.033</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="wheel_left_visual">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_right_link">
      <pose>0 -0.080 0.033 -1.5707963 0 0</pose>
      <inertial><mass>0.0285</mass>
        <inertia><ixx>1.1e-05</ixx><iyy>1.1e-05</iyy><izz>2.0e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- sphere collision: DART cylinder-plane contact made the wheels slip in spins (docs/progress.md) -->
      <collision name="wheel_right_collision">
        <geometry><sphere><radius>0.033</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="wheel_right_visual">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <!-- rolling ball caster on a ball joint (a welded zero-friction sphere made the wheels slip) -->
    <link name="caster_back_link">
      <pose>-0.081 0 0.010 0 0 0</pose>
      <inertial><mass>0.005</mass>
        <inertia><ixx>2e-07</ixx><iyy>2e-07</iyy><izz>2e-07</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="caster_collision">
        <geometry><sphere><radius>0.010</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <joint name="base_joint" type="fixed"><parent>base_footprint</parent><child>base_link</child></joint>
    <joint name="scan_joint" type="fixed"><parent>base_link</parent><child>base_scan</child></joint>
    <joint name="caster_back_joint" type="ball"><parent>base_link</parent><child>caster_back_link</child></joint>
    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent><child>wheel_left_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent><child>wheel_right_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.160</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <!-- min_* must be set explicitly: otherwise deceleration/reversal is unlimited and the
           wheels lose traction (measured, docs/progress.md) -->
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
      <min_linear_velocity>-0.22</min_linear_velocity>
      <min_angular_velocity>-2.84</min_angular_velocity>
      <max_linear_velocity>0.22</max_linear_velocity>
      <max_angular_velocity>2.84</max_angular_velocity>
      <topic>cmd_vel</topic>
      <!-- wheel odometry kept for evidence only (/wheel_odom); its TF goes to an unbridged topic -->
      <odom_topic>wheel_odom</odom_topic>
      <tf_topic>model/turtlebot3_burger/wheel_tf_unused</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <!-- Odometry source used by ROS (single odom->base_footprint authority). DART wheel odometry
         slipped up to ~50 % in rotation on this VM (docs/progress.md), so odometry is derived from the
         simulated model pose with added Gaussian noise. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <dimensions>2</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
      <gaussian_noise>0.001</gaussian_noise>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </model>
</sdf>
